{
	"compilerOptions": {
		"target": "ES2020",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"lib": [
			"DOM",
			"DOM.Iterable",
			"ES2021"
		],
		"strict": true,
		"noEmit": true,
		"skipLibCheck": true,
		"allowSyntheticDefaultImports": true,
		"isolatedModules": true
	},
	"include": [
		"src/**/*.ts"
	]
}